# ==========================================================================
#  Copy to .env and fill in your values.  .env is git-ignored.
# ==========================================================================

# --- Website server (server.js) -------------------------------------------
PORT=3000
ADMIN_USER=gtec_admin
ADMIN_PASS=change-me

# AI server used by the Express proxy (/api/predict, /api/chat).
#   Local dev  : http://127.0.0.1:5001
#   Production : https://<username>-gtec-ai-server.hf.space
AI_BASE_URL=http://127.0.0.1:5001

# --- AI server (ai_server.py) ---------------------------------------------
# Backend used by the intent classifier:
#   lite  -> ~1 MB TF-IDF model, ~120 MB RAM, no PyTorch   (DEFAULT)
#   torch -> DistilBERT, ~800 MB RAM, needs requirements-train.txt
#   auto  -> try lite first, fall back to torch if available
MODEL_BACKEND=lite

# Hugging Face Model Hub repo holding the trained weights.
# ai_server.py downloads from here on startup and caches it in
# %USERPROFILE%\.cache\huggingface\hub (~1 MB, one time).
# Leave it empty to use the local model/ folder instead.
MODEL_ID=GtecBuddy/gtec-intent-model

# Only needed when the model repo is private.
HF_TOKEN=

# Flask binding for local development. The Docker Space overrides these
# itself (HOST=0.0.0.0, PORT=7860), so do not set them there.
# HOST=127.0.0.1
# PORT=5001
